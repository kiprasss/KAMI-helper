{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KAMI Helper",
  "version": "0.1.0",
  "identifier": "com.kami.helper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KAMI Helper",
        "width": 950,
        "height": 600,
        "minWidth": 950,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "center": true,
        "visible": true,
        "skipTaskbar": true
      },
      {
        "label": "mini",
        "title": "KAMI Helper",
        "width": 300,
        "height": 46,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.novarp.games https://s3.grandroleplay.ru http://localhost:8080 http://127.0.0.1:8080; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:8080 http://127.0.0.1:8080 https:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
